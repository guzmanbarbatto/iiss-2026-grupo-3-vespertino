# Plantilla de configuración de EcoWarm.
# Copiarla a docker/.env y completarla: cp docker/.env.example docker/.env
# docker/.env no se versiona porque tiene claves. Usar claves nuevas: nunca reutilizar una que
# haya estado en el repositorio.

# --- Base de datos (el PostgreSQL del docker-compose) ---
DB_USER=ecowarm
DB_PASS=cambiar-esta-clave
DB_NAME=ecowarm
DB_URL=jdbc:postgresql://postgres-db:5432/ecowarm

# --- Engine ---
# Clave que el engine exige en X-API-Key y que le declara al simulador al registrarse (§6).
APP_API_KEY=cambiar-por-una-clave-larga-y-aleatoria

# --- Simulador de la cátedra ---
# Con ecowarm-run corriendo en esta misma máquina:
SIMULADOR_URL=http://host.docker.internal:9090
# Clave que exige el simulador. ecowarm-run usa iiss-2026 si no se le pasa --clave.
SIMULADOR_API_KEY=iiss-2026

# --- Opcionales ---
# Si no se usan, dejarlas comentadas. Una variable definida pero vacía no es lo mismo que una que no
# está: CONTROLADOR_BASE_URL vacía haría que el engine se registre con una dirección vacía.

# Dirección en la que el simulador alcanza al engine. Por defecto, http://localhost:8080.
# Con el simulador en otra máquina de la red local, la IP de esta máquina:
# CONTROLADOR_BASE_URL=http://192.168.1.10:8080

# Broker MQTT. Si no se define, se usa el que anuncia el simulador al registrarse.
# MQTT_BROKER_URL=tcp://host.docker.internal:1883

# Reemplaza el urlSwitch de todas las habitaciones (si el que anuncia el simulador no es alcanzable).
# SWITCHES_URL=http://host.docker.internal:9090

# Clave del servidor MCP. Sin ella, el MCP queda abierto: definirla fuera de desarrollo local.
# MCP_API_KEY=cambiar-por-otra-clave

# Orígenes web que pueden usar el MCP desde un navegador. Por defecto, solo localhost.
# MCP_CORS_ORIGINS=http://localhost:[*],http://127.0.0.1:[*]
